# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase connection pooler string (Transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── Stripe ───────────────────────────────────────────────────────────────────
# From Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# From Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# Endpoint to register: https://thursdaydrop.ca/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email ────────────────────────────────────────────────────────────────────
# From Resend Dashboard → API Keys
RESEND_API_KEY=re_...

# ─── Auth ─────────────────────────────────────────────────────────────────────
# A strong random string used for the hidden admin login at /admin-login
ADMIN_PASSWORD=choose-a-strong-password-here

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Vercel automatically sends this as "Authorization: Bearer <CRON_SECRET>"
# when invoking cron jobs. Set this to any strong random string.
# The same value must be used for CRON_SECRET in Vercel env vars.
CRON_SECRET=choose-a-strong-secret-here

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
