{
  "version": 2,
  "installCommand": "pnpm install --config.minimumReleaseAge=0",
  "buildCommand": "pnpm -w run typecheck:libs && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/thursday-drop run build",
  "outputDirectory": "artifacts/thursday-drop/dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "0 13 * * 4"
    },
    {
      "path": "/api/cron/scrape",
      "schedule": "0 14 * * 4"
    },
    {
      "path": "/api/cron/morning-alerts",
      "schedule": "0 11 * * 4"
    },
    {
      "path": "/api/cron/morning-alerts",
      "schedule": "0 12 * * 4"
    }
  ]
}
